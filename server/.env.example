# این فایل رو کپی کن به .env و مقادیر واقعی رو بذار توش. .env هیچ‌وقت commit نشه.

# یه رشته‌ی تصادفی و طولانی و مخفی برای امضای توکن‌های ورود (JWT).
# مثال ساختنش: openssl rand -hex 48
JWT_SECRET=

# کلید API سرویس پیامکی پیام‌رسان (payam-resan.com / sms-webservice.com). اگه خالی بمونه،
# کد تایید فقط تو لاگ سرور چاپ می‌شه و پیامک واقعی ارسال نمی‌شه (فقط برای تست محلی مناسبه).
PAYAMRESAN_API_KEY=
PAYAMRESAN_SENDER=

# تایید خرید اشتراک از طریق پرداخت درون‌برنامه‌ای کافه‌بازار. اگه خالی بمونن،
# POST /api/subscription/verify همیشه 503 می‌ده (خرید هیچ‌وقت تایید نمی‌شه).
# راهنمای گرفتنشون تو server/README.md هست.
CAFEBAZAAR_PACKAGE_NAME=ir.sadteam.loancalc
CAFEBAZAAR_CLIENT_ID=
CAFEBAZAAR_CLIENT_SECRET=
CAFEBAZAAR_REFRESH_TOKEN=

# پورتی که سرور روش بالا میاد
PORT=3000

# مسیر فایل SQLite. اگه خالی بمونه، کنار jar (به اسم data.sqlite) ساخته می‌شه.
DB_PATH=
