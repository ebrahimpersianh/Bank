# این فایل رو کپی کن به .env و مقادیر واقعی رو بذار توش. .env هیچ‌وقت commit نشه.

# یه رشته‌ی تصادفی و طولانی و مخفی برای امضای توکن‌های ورود (JWT).
# مثال ساختنش: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# کلید API سرویس پیامکی پیام‌رسان (payam-resan.com / sms-webservice.com). اگه خالی بمونه،
# کد تایید فقط تو لاگ سرور چاپ می‌شه و پیامک واقعی ارسال نمی‌شه (فقط برای تست محلی مناسبه).
PAYAMRESAN_API_KEY=
PAYAMRESAN_SENDER=

# پورتی که سرور روش بالا میاد
PORT=3000
