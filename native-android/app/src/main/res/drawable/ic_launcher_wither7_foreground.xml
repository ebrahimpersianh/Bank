<!--
  آیکونِ تطبیقی، طرحِ «الف — کیفِ جیبک» · پیش‌زمینه · فریمِ 58a

  ═══ هندسه ═══
  بومِ ۱۰۸، ناحیه‌ی امن دایره‌ی ۶۶ وسط. هیچ جسمی بیرونِ آن نیست (58c بندِ ۱).

  همان قاعده‌ی هندسیِ لوگو رعایت شده: سکه **نصف** زیرِ در است، نه ۷۰٪ —
  مرکزِ سکه روی خطِ بالای در می‌نشیند (cy == flapTop). زبانه‌ی قفل نیامد؛ در هر
  اندازه‌ای روی نیمه‌ی پیدای سکه می‌نشست و طلا هلالِ باریک می‌شد.

  ═══ ناحیه‌ی مصون ═══
  گروهِ `immune` **فقط** سکه است و نه بیشتر (58c بندِ ۳). در پله‌ی ۳۰ بدنه‌ی کیف
  اشباعش تا ۰ می‌افتد ولی سکه دستِ‌کم ۰٫۶۵ نگه می‌دارد:

      markSaturate = max(0.65, 1 − 0.05·n)     ← داخلِ immune
      markDust     = 0
      bodySaturate = max(0.00, 1 − 0.10·n)     ← بیرونش

  عنکبوت و ترک روی **کل** می‌مانند؛ رویه‌اند نه رنگ، پس immune از آن‌ها مصون نیست.

  ⚠️ `android:name` روی <group> برای اعمالِ پژمردگی لازم است — `IconWither.kt` با
  همین نام پیدایش می‌کند. عوضش نکنید.
-->
<!-- ساختهٔ generate-wither.py - پلهٔ 7. دستی ویرایشش نکن. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- بدنه‌ی کیف. ناودانِ بالا (sweep=0) شکافی می‌سازد که سکه از آن بیرون می‌زند،
         پس سکه با هندسه از بدنه جدا می‌شود نه با رنگ. -->
    <group android:name="body">
        <path
            android:fillColor="#B6AB8C"
            android:pathData="M31,47 L35.4,47 A21.6,21.6 0 0 0 76.6,47 L81,47 A15.8,15.8 0 0 1 96.8,62.8 L96.8,89 A15.8,15.8 0 0 1 81,104.8 L31,104.8 A15.8,15.8 0 0 1 15.2,89 L15.2,62.8 A15.8,15.8 0 0 1 31,47 Z" />

        <!-- بندِ افقی. هم‌رنگِ پس‌زمینه است نه یک طلاییِ دیگر: در پله‌های بالا که
             بدنه خاکستری می‌شود، بندِ طلایی به یک خطِ شناور تبدیل می‌شد. -->
        <path
            android:fillColor="#0B3A2A"
            android:pathData="M15.2,72.4 L96.8,72.4 L96.8,79.2 L15.2,79.2 Z" />
    </group>

    <!-- ناحیه‌ی مصون: سکه. -->
    <group android:name="immune">
        <path
            android:fillColor="#E8DDB6"
            android:pathData="M39.8,39.6 A16.2,16.2 0 1 0 72.2,39.6 A16.2,16.2 0 1 0 39.8,39.6 Z" />
        <path
            android:fillColor="#0B3A2A"
            android:fillAlpha="0.22"
            android:pathData="M47.6,39.6 A8.4,8.4 0 1 0 64.4,39.6 A8.4,8.4 0 1 0 47.6,39.6 Z M51,39.6 A5,5 0 1 1 61,39.6 A5,5 0 1 1 51,39.6 Z" />
    </group>

</vector>
