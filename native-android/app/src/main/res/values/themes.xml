<resources>
    <!-- تم پایه فقط برای پنجره/استارت اپ لازمه؛ ظاهر واقعی همه‌جا با Compose (ui/theme) کنترل می‌شه -->
    <style name="Theme.LoanCalc" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
    </style>

    <!-- اینترو/اسپلش‌اسکرین واقعی موقع باز شدن اپ (قبلاً اصلاً وجود نداشت). MainActivity با
         installSplashScreen() این تم رو موقتاً فعال می‌کنه، بعدش خودکار به Theme.LoanCalc برمی‌گرده. -->
    <style name="Theme.LoanCalc.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_bg</item>
        <!-- آیکونِ اسپلشِ سیستمی عمداً شفافه: ماسکِ دایره‌ای اندروید ۱۲ دونات رو زشت می‌بُرید و
             کاربر خواست این صفحه‌ی اضافه حذف بشه؛ اینتروِ دوناتیِ واقعی تو Compose نشون داده می‌شه. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.LoanCalc</item>
    </style>
</resources>
