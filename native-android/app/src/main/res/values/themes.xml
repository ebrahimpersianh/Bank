<resources>
    <!-- تم پایه فقط برای پنجره/استارت اپ لازمه؛ ظاهر واقعی همه‌جا با Compose (ui/theme) کنترل می‌شه -->
    <style name="Theme.LoanCalc" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
    </style>

    <!-- فریمِ اولِ اندروید باید امتدادِ همان اینتروی Compose باشد: زمینهٔ کرم،
         نشان واقعیِ جیبک و بدونِ فلاش/صفحهٔ خالی. بعد از آماده‌شدنِ Compose، سکه می‌افتد،
         کیف ظاهر می‌شود و متن و نوار پیشرفت وارد می‌شوند. -->
    <style name="Theme.LoanCalc.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_none</item>
        <item name="postSplashScreenTheme">@style/Theme.LoanCalc</item>
    </style>
</resources>
