<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- برای یادآوری سررسید (نوتیفیکیشن) - از Android 13 (API 33) به بعد اجباریه، فقط runtime هم
         باید درخواست بشه (ui/settings/SettingsScreen.kt، ui/onboarding/PermissionGateScreen.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- برای گیت مجوز اول اپ (PermissionGateScreen) - بدون این، Intent
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS اجرا نمی‌شه. لازمه چون WorkManager (یادآوری
         سررسید) رو خیلی گوشی‌ها بدون معافیت از بهینه‌سازی باتری پس‌زمینه‌ش کشته می‌شه. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- برای «افزودن سررسید اقساط به تقویم گوشی» (calendar/DeviceCalendarExporter) - runtime تو
         LoanDetailScreen درخواست می‌شن؛ READ لازمه چون قبل از درج باید تقویمِ قابل‌نوشتن پیدا بشه. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- برای ویبره‌ی واقعی رو تپ‌های اصلی (ui/haptics/Haptics.kt) - ویژگی اشتراکی. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- برای «خوندنِ خودکارِ پیامکِ بانکی» (notifications/BankSmsReceiver.kt) - runtime تو
         SettingsScreen درخواست می‌شه، فقط وقتی کاربر صریح سوییچش رو روشن می‌کنه؛ پیش‌فرضِ فیچر خودش
         هم خاموشه (UiPrefs.smsAutoImportEnabled). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- فقط برای «انتخابِ شماره‌ی پیامکِ بانک از رو صندوقِ پیامک» تو فرمِ افزودن/ویرایشِ حساب
         (ui/account/SmsSenderPicker.kt) - خواسته‌ی صریحِ کاربر، تا مجبور نباشه سرشماره رو دستی
         تایپ کنه. runtime و فقط لحظه‌ی زدنِ همون دکمه درخواست می‌شه؛ اپ فقط فرستنده و یه نمونه‌ی
         کوتاه از متن رو *رو خودِ گوشی* می‌خونه تا لیست رو نشون بده و هیچ‌چیزی جایی فرستاده نمی‌شه.
         اگه کاربر اجازه نده، تایپِ دستی همچنان کار می‌کنه. -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- allowBackup عمداً false: بکاپ خودکار اندروید موقع نصب مجدد، فلگ‌های «یه‌بار پرسیده شده»
         (ورود/مهمان، benefits، گیت مجوزها) رو از نصب قبلی برمی‌گردوند و در نتیجه سوال‌های اولین
         اجرا دیگه هیچ‌وقت نشون داده نمی‌شدن (گزارش کاربر). داده‌ی کاربر راه‌های بکاپ خودش رو داره
         (پشتیبان‌گیری داخل اپ + سینک ابری + پشتیبان‌گیری خودکار روزانه). -->
    <!-- 🚨 از اندروید ۱۱ (API 30) به بعد «دیده‌شدنِ بسته‌ها» محدود شده: بدونِ این بلوک،
         getInstalledApplications فقط اپ‌های سیستمی و چندتای معدود رو برمی‌گردونه. گزارشِ واقعیِ
         کاربر همین بود - تو صفحه‌ی «اعلانِ کدوم اپ‌ها خونده بشه؟» هیچ اپِ بانکی‌ای دیده نمی‌شد،
         فقط دوربین/ساعت/قطب‌نما/گالری. این فیلترِ intent همه‌ی اپ‌های **قابلِ‌اجرا** رو نمایان
         می‌کنه - نه مجوزِ حساسِ QUERY_ALL_PACKAGES که استورها ازش توضیح می‌خوان و اینجا لازم هم
         نیست، چون فقط دنبالِ اپ‌هایی هستیم که کاربر خودش تو لانچر می‌بینه. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LoanCalcApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.LoanCalc"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LoanCalc.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- میان‌برهای فشارِ طولانی رو آیکونِ اپ (مثلِ دولینگو) - رجوع کن به res/xml/shortcuts.xml -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- ویجت صفحه اصلی (قسط بعدی) - رجوع کن به ui/widget/LoanWidget.kt -->
        <receiver
            android:name=".ui.widget.LoanWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/loan_widget_info" />
        </receiver>

        <!-- خوندنِ خودکارِ پیامکِ بانکی - رجوع کن به notifications/BankSmsReceiver.kt. exported=true
             اجباریه چون سیستم (نه خودِ اپ) این Broadcast رو می‌فرسته؛ android:permission محدودش
             می‌کنه که فقط خودِ سیستم (که BROADCAST_SMS داره) بتونه این Broadcast رو بفرسته. -->
        <receiver
            android:name=".notifications.BankSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- خوندنِ خودکارِ اعلانِ اپ‌های بانکی - برای بانک‌های دیجیتال (بلوبانک و…) که اصلاً پیامک
             نمی‌فرستن. رجوع کن به notifications/BankNotificationListener.kt.
             این سرویس **فقط** وقتی کار می‌کنه که هر سه شرط برقرار باشه: (۱) کاربر سوییچش رو تو
             تنظیمات روشن کرده باشه (پیش‌فرض خاموش)، (۲) دسترسیِ «خواندن اعلان‌ها» رو دستی از
             تنظیماتِ گوشی داده باشه (دیالوگِ Runtime نداره)، و (۳) اپِ فرستنده تو لیستِ سفیدِ
             انتخاب‌شده‌ی خودش باشه. exported=true اجباریه چون سیستم به سرویس bind می‌کنه؛
             android:permission محدودش می‌کنه که فقط خودِ سیستم بتونه bind کنه. -->
        <service
            android:name=".notifications.BankNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- WorkManager رو خودمون با HiltWorkerFactory مقداردهی می‌کنیم (LoanCalcApplication پیاده‌ی
             Configuration.Provider هست) - initializer پیش‌فرض androidx.startup باید غیرفعال بشه. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
