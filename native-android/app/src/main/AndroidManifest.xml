        <!-- کنش‌های داخلِ اعلان («پرداخت شد» / «فردا یادم بیاور») - رجوع کن به
             notifications/NotificationActionReceiver.kt. exported=false چون فقط
             PendingIntentهای خودِ اپ صداش می‌زنن. -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- چیدنِ دوباره‌ی کارهای زمان‌بندی‌شده بعد از ری‌استارتِ گوشی یا آپدیتِ خودِ اپ. -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- خوندنِ خودکارِ پیامکِ بانکی - رجوع کن به notifications/BankSmsReceiver.kt. exported=true
             اجباریه چون سیستم (نه خودِ اپ) این Broadcast رو می‌فرسته؛ android:permission محدودش
             می‌کنه که فقط خودِ سیستم (که BROADCAST_SMS داره) بتونه این Broadcast رو بفرسته. -->
        <receiver
            android:name=".notifications.BankSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- خوندنِ خودکارِ اعلانِ اپ‌های بانکی - برای بانک‌های دیجیتال (بلوبانک و…) که اصلاً پیامک
             نمی‌فرستن. رجوع کن به notifications/BankNotificationListener.kt.
             این سرویس **فقط** وقتی کار می‌کنه که هر سه شرط برقرار باشه: (۱) کاربر سوییچش رو تو
             تنظیمات روشن کرده باشه (پیش‌فرض خاموش)، (۲) دسترسیِ «خواندن اعلان‌ها» رو دستی از
             تنظیماتِ گوشی داده باشه (دیالوگِ Runtime نداره)، و (۳) اپِ فرستنده تو لیستِ سفیدِ
             انتخاب‌شده‌ی خودش باشه. exported=true اجباریه چون سیستم به سرویس bind می‌کنه؛
             android:permission محدودش می‌کنه که فقط خودِ سیستم بتونه bind کنه. -->
        <service
            android:name=".notifications.BankNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- WorkManager رو خودمون با HiltWorkerFactory مقداردهی می‌کنیم (LoanCalcApplication پیاده‌ی
             Configuration.Provider هست) - initializer پیش‌فرض androidx.startup باید غیرفعال بشه. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    
