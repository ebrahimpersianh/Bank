<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- برای یادآوری سررسید (نوتیفیکیشن) - از Android 13 (API 33) به بعد اجباریه، فقط runtime هم
         باید درخواست بشه (ui/settings/SettingsScreen.kt، ui/onboarding/PermissionGateScreen.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- برای گیت مجوز اول اپ (PermissionGateScreen) - بدون این، Intent
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS اجرا نمی‌شه. لازمه چون WorkManager (یادآوری
         سررسید) رو خیلی گوشی‌ها بدون معافیت از بهینه‌سازی باتری پس‌زمینه‌ش کشته می‌شه. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- برای چیدنِ دوباره‌ی یادآورها بلافاصله بعد از روشن‌شدنِ گوشی (notifications/BootReceiver.kt).
         WorkManager خودش هم این مجوز را اعلام می‌کند، ولی صریح نوشتنش اینجا وابستگی را روشن نگه
         می‌دارد. ⚠️ روی شیائومی/هواوی/اوپو/ویوو تا «اجرای خودکار» اپ دستی روشن نشود این
         Broadcast اصلاً به اپ نمی‌رسد - محدودیتِ سازنده، نه باگِ ما. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- برای «افزودن سررسید اقساط به تقویم گوشی» (calendar/DeviceCalendarExporter) - runtime تو
         LoanDetailScreen درخواست می‌شن؛ READ لازمه چون قبل از درج باید تقویمِ قابل‌نوشتن پیدا بشه. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- برای ویبره‌ی واقعی رو تپ‌های اصلی (ui/haptics/Haptics.kt) - ویژگی اشتراکی. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- برای «خوندنِ خودکارِ پیامکِ بانکی» (notifications/BankSmsReceiver.kt) - runtime تو
         SettingsScreen درخواست می‌شه، فقط وقتی کاربر صریح سوییچش رو روشن می‌کنه؛ پیش‌فرضِ فیچر خودش
         هم خاموشه (UiPrefs.smsAutoImportEnabled). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- فقط برای «انتخابِ شماره‌ی پیامکِ بانک از رو صندوقِ پیامک» تو فرمِ افزودن/ویرایشِ حساب
         (ui/account/SmsSenderPicker.kt) - خواسته‌ی صریحِ کاربر، تا مجبور نباشه سرشماره رو دستی
         تایپ کنه. runtime و فقط لحظه‌ی زدنِ همون دکمه درخواست می‌شه؛ اپ فقط فرستنده و یه نمونه‌ی
         کوتاه از متن رو *رو خودِ گوشی* می‌خونه تا لیست رو نشون بده و هیچ‌چیزی جایی فرستاده نمی‌شه.
         اگه کاربر اجازه نده، تایپِ دستی همچنان کار می‌کنه. -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- allowBackup عمداً false: بکاپ خودکار اندروید موقع نصب مجدد، فلگ‌های «یه‌بار پرسیده شده»
         (ورود/مهمان، benefits، گیت مجوزها) رو از نصب قبلی برمی‌گردوند و در نتیجه سوال‌های اولین
         اجرا دیگه هیچ‌وقت نشون داده نمی‌شدن (گزارش کاربر). داده‌ی کاربر راه‌های بکاپ خودش رو داره
         (پشتیبان‌گیری داخل اپ + سینک ابری + پشتیبان‌گیری خودکار روزانه). -->
    <!-- 🚨 از اندروید ۱۱ (API 30) به بعد «دیده‌شدنِ بسته‌ها» محدود شده: بدونِ این بلوک،
         getInstalledApplications فقط اپ‌های سیستمی و چندتای معدود رو برمی‌گردونه. گزارشِ واقعیِ
         کاربر همین بود - تو صفحه‌ی «اعلانِ کدوم اپ‌ها خونده بشه؟» هیچ اپِ بانکی‌ای دیده نمی‌شد،
         فقط دوربین/ساعت/قطب‌نما/گالری. این فیلترِ intent همه‌ی اپ‌های **قابلِ‌اجرا** رو نمایان
         می‌کنه - نه مجوزِ حساسِ QUERY_ALL_PACKAGES که استورها ازش توضیح می‌خوان و اینجا لازم هم
         نیست، چون فقط دنبالِ اپ‌هایی هستیم که کاربر خودش تو لانچر می‌بینه. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LoanCalcApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.LoanCalc"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LoanCalc.Splash"
            android:windowSoftInputMode="adjustResize">
            <!-- ⚠️ فیلترِ LAUNCHER از این‌جا **برداشته شد** و رفت روی alias‌ها (پایین).
                 پژمردگیِ آیکون (`49b`) با فعال/غیرفعال‌کردنِ alias کار می‌کند و اکتیویتیِ
                 اصلی هیچ‌وقت غیرفعال نمی‌شود - غیرفعال‌کردنش یعنی از بین رفتنِ دیپ‌لینک‌ها
                 و اعلان‌های بازشونده. -->
            <!-- 🚨 «اشتراک‌گذاریِ» متن از برنامه‌ی پیامکِ خودِ گوشی.
                 اندروید اجازه نمی‌دهد ما داخلِ برنامه‌ی پیامکِ گوشی دکمه بگذاریم (مالِ
                 سازنده‌ی دیگری است) و هیچ «انتخابگرِ پیامکِ سیستمی» هم ندارد. تنها پلِ
                 رسمی همین است: کاربر پیام را نگه می‌دارد، «اشتراک‌گذاری» می‌زند و جیبک را
                 انتخاب می‌کند. رجوع کن به PendingSharedSms. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- میان‌برهای فشارِ طولانی رو آیکونِ اپ (مثلِ دولینگو) - رجوع کن به res/xml/shortcuts.xml -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- ══ آیکونِ لانچر: پله‌ی صفر + هشت پله‌ی پژمردگی ══════════════════════════
             همیشه **دقیقاً یکی** از این نه‌تا فعال است. `IconWither.kt` اول پله‌ی تازه را
             فعال می‌کند بعد بقیه را خاموش، تا هیچ لحظه‌ای بی‌آیکون نمانیم.
             ⚠️ `targetActivity` همه‌شان همان MainActivity است، پس تپ روی هر پله‌ای همان اپ
             را باز می‌کند. -->
        <!--
          🚨 آیکونِ **خریدنی** (`60b`) - سه الیاسِ زیر، نه سی‌ودو تا.
          قاعده‌ی طراح: الیاسِ بی‌مقصد فعال نشود. هر طرح فقط **یک** الیاس دارد چون
          پله‌های پژمردگی تنها برای طرحِ پیش‌فرض («کیفِ پول») ساخته شده‌اند؛ آیکونِ
          خریداری‌شده همیشه پله‌ی صفر است.
          همیشه دقیقاً یکی از کلِ الیاس‌ها روشن است (رجوع کن به `IconWither.apply`)،
          وگرنه برنامه چندبار در فهرستِ گوشی دیده می‌شود.
        -->
