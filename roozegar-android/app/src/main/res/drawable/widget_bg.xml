<?xml version="1.0" encoding="utf-8"?>
<!-- پس‌زمینه‌ی شیشه‌ای ویجت‌ها: سرمه‌ای نیمه‌شفاف با گوشه‌ی گرد و حاشیه‌ی روشنِ ظریف - همون زبان
     طراحی GlassCard داخل اپ، ولی به‌صورت drawable چون Glance فقط همین رو می‌فهمه. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E60F2036"
        android:endColor="#E60B1626" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#40FFFFFF" />
</shape>
