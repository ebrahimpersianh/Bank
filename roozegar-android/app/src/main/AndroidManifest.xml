<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- اعلان دائمی تاریخ (اندروید ۱۳+) - تو آنبوردینگ با توضیح گرفته می‌شه. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- بعد از خاموش/روشن‌شدن گوشی، اعلان تاریخ و آلارم نیمه‌شب دوباره برپا می‌شن. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- تعویض عدد روز دقیقاً رأس نیمه‌شب. USE_EXACT_ALARM برای اپ تقویم مجازه و خودکار داده می‌شه؛
         SCHEDULE_EXACT_ALARM هم به‌عنوان پشتیبان اومده و تو کد با canScheduleExactAlarms گارد شده. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- درخواست خارج‌شدن از بهینه‌سازی باتری (تو آنبوردینگ، تا اعلان دائمی رو گوشی‌های سخت‌گیر
         کشته نشه) - تو کافه‌بازار/مایکت مجازه (محدودیت گوگل‌پلی این‌جا موضوعیت نداره). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".RoozegarApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Roozegar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- بازسازی اعلان تاریخ + آلارم نیمه‌شب + ویجت‌ها بعد از بوت/تغییر ساعت/تعویض منطقه‌ی
             زمانی/آپدیت اپ. این اکشن‌ها broadcast محافظت‌شده‌ی خود سیستمن (فقط سیستم می‌تونه
             بفرسته)، پس exported بودنش خطری نداره. -->
        <receiver
            android:name=".notif.DateChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ویجت کوچک «امروز» -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- ویجت ماه کامل -->
        <receiver
            android:name=".widget.MonthWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_month_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_info" />
        </receiver>
    </application>
</manifest>
